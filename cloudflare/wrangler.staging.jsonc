// Public sample-data demo. Set PUBLIC_DEMO to false to restore app-level login.
// Use this explicit config; do not deploy the managed Site's generated config.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "10tacles-staging",
  "account_id": "e10eecc148c8ccc7a82cecd6c9a58fc6",
  "main": "entry.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    "PUBLIC_DEMO": "true",
    "ACCESS_TEAM_DOMAIN": "johnthevid.cloudflareaccess.com",
    "ACCESS_AUD": "605898e653a619fc0c3dda8d8ec1a78f567f615785e9cd314a5b6d978f0727d4",
    "ACCESS_EMAIL": "johndavidceasar@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "10tacles-staging",
      "database_id": "5b575b28-4eed-4680-b442-96dbf0c5f79f",
      "migrations_dir": "../drizzle"
    }
  ]
}
